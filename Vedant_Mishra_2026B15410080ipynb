        "# Task 2\n",
        "print(\"Missing values per column:\\n\", df.isna().sum())\n",
        "miss = df[df[\"Delivery_Time_Min\"].isna()]\n",
        "print(\"\\nMissing delivery times by order status:\")\n",
        "print(miss[\"Order_Status\"].value_counts())\n",
        "\n",
        "# Handling decision:\n",
        "# - Cancelled orders were never delivered, so a missing time is expected -> keep as NaN (excluded from averages)\n",
        "# - Other missing values (Delivered/Delayed) are data gaps -> fill with the median delivery time of the same city\n",
        "mask = df[\"Delivery_Time_Min\"].isna() & (df[\"Order_Status\"] != \"Cancelled\")\n",
        "city_median = df.groupby(\"City\")[\"Delivery_Time_Min\"].transform(\"median\")\n",
        "df.loc[mask, \"Delivery_Time_Min\"] = city_median[mask]\n",
        "print(\"\\nRemaining missing delivery times (all should be Cancelled):\", df[\"Delivery_Time_Min\"].isna().sum())\n",
        "print(\"Of which cancelled:\", (df[\"Delivery_Time_Min\"].isna() & (df[\"Order_Status\"] == \"Cancelled\")).sum())"
